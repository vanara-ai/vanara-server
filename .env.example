# Vanara.ai backend — environment configuration
#
# None of these are required for the core BYOK flow.
# API keys are supplied per-request by the client via the X-Groq-Key header —
# NOT via this file. Never put a Groq key in .env.

# ── Server ────────────────────────────────────────────────────────────────
# Port uvicorn binds to (Render/Fly/Railway set this automatically).
PORT=8000

# Comma-separated list of origins allowed by CORS.
# Include your frontend's dev + deploy URLs.
CORS_ORIGINS=http://localhost:3000

# ── Optional: Supabase persistence ────────────────────────────────────────
# Enables resume history, parsed-resume reuse, feedback persistence, and
# request audit logging. Leave unset to run stateless — the core
# /optimize_resume/ endpoint works either way.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-role-or-anon-key

# ── Optional: feedback email delivery ─────────────────────────────────────
# If any SMTP_* var is unset, feedback is still accepted (and stored to
# Supabase if configured) but no email is sent.
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# FROM_EMAIL=noreply@yourdomain.com
# TO_EMAIL=you@yourdomain.com
